# Copy file này thành .env.local rồi điền key thật:
#   cp .env.example .env.local
#
# Chưa có key cũng chạy được: web sẽ lưu dữ liệu vào localStorage
# của trình duyệt, chỉ tính năng AI kiểm tra mâu thuẫn là chưa dùng được.

# --- Supabase (tạo project tại https://supabase.com/dashboard) ---
# Lấy ở: Project Settings > API > Project URL và anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# --- Gemini (lấy key miễn phí tại https://aistudio.google.com/apikey) ---
# Key này chỉ dùng phía server, không lộ ra trình duyệt.
GEMINI_API_KEY=

# Model kiểm tra mâu thuẫn (chất lượng cao). Mặc định: gemini-3.8-flash.
# LƯU Ý: gemini-2.5-flash đã ngừng phục vụ user mới (API trả 404) — đừng dùng.
# Nếu 3.8-flash lỗi 503/429, web tự fallback sang GEMINI_BULK_MODEL.
GEMINI_MODEL=gemini-3.8-flash

# Model nhẹ cho việc hàng loạt (tóm tắt chương, cập nhật tóm tắt arc)
# và làm dự phòng khi model chính lỗi. Mặc định: gemini-3.5-flash-lite.
GEMINI_BULK_MODEL=gemini-3.5-flash-lite

# Model embedding cho RAG. Mặc định: gemini-embedding-001.
# (text-embedding-004 không còn tồn tại.) Web luôn ép output 768 chiều
# để khớp cột vector(768) trong supabase/schema.sql.
GEMINI_EMBED_MODEL=gemini-embedding-001
